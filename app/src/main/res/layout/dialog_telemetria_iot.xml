<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F1F4F2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Telemetria da frota"
            android:textColor="#18323B"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatusThingSpeak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Conectando ao ThingSpeak..."
            android:textColor="#73848A"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAtualizarThingSpeak"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:text="Atualizar leituras"
            android:textAllCaps="false"
            app:backgroundTint="#173B4D"
            app:cornerRadius="8dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="10dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Lotação estimada"
                    android:textColor="#73848A"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tvLotacao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="--%"
                    android:textColor="#E36B54"
                    android:textSize="25sp"
                    android:textStyle="bold" />
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressoLotacao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="0"
                    app:indicatorColor="#E36B54"
                    app:trackColor="#FCEBE6" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Velocidade média da frota"
                    android:textColor="#73848A"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tvVelocidadeFrota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="-- km/h"
                    android:textColor="#278B72"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Temperatura interna"
                    android:textColor="#73848A"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tvTemperaturaFrota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="-- °C"
                    android:textColor="#B78C20"
                    android:textSize="25sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Histórico dos sensores"
            android:textColor="#18323B"
            android:textSize="15sp"
            android:textStyle="bold" />

        <WebView
            android:id="@+id/webViewThingSpeak"
            android:layout_width="match_parent"
            android:layout_height="520dp"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF" />
    </LinearLayout>
</ScrollView>