<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- MAPA (Oculto no início, surge após definir local/rota) -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- TELA INICIAL: PAINEL PRINCIPAL EXECUTIVO -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/painelBusca"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Cabeçalho de Boas-Vindas Executivo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SPBus Executivo"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="#1A237E"
                    android:letterSpacing="0.02" />

                <TextView
                    android:id="@+id/textoStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Para onde você deseja ir hoje?"
                    android:textSize="14sp"
                    android:textColor="#5C6BC0"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- CARD DE PESQUISA ELEGANTE -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="1dp"
                app:strokeColor="#E8EAF6">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Campo Origem com Botão de GPS Integrado -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Origem / Ponto de Partida"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:endIconMode="custom"
                        app:endIconDrawable="@android:drawable/ic_menu_mylocation"
                        app:endIconTint="#1A237E"
                        app:endIconContentDescription="Usar minha localização atual"
                        android:layout_marginBottom="12dp">

                        <AutoCompleteTextView
                            android:id="@+id/campoOrigem"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPostalAddress"
                            android:textSize="15sp"
                            android:paddingVertical="14dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Campo Destino -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Destino Desejado"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:startIconDrawable="@android:drawable/ic_dialog_map"
                        app:startIconTint="#1A237E"
                        android:layout_marginBottom="20dp">

                        <AutoCompleteTextView
                            android:id="@+id/campoDestino"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPostalAddress"
                            android:textSize="15sp"
                            android:paddingVertical="14dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Botão Tracar Rota Executivo -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/botaoTracejar"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Buscar Melhores Rotas"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:cornerRadius="14dp"
                        android:backgroundTint="#1A237E"
                        app:elevation="4dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CARD DE MURAL / FEEDBACKS DOS PASSAGEIROS -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFeedbacksRota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#E8EAF6">

                <TextView
                    android:id="@+id/textoFeedbacksPassageiros"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:textColor="#1A237E"
                    android:textSize="13sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- CONTAINER DE OPÇÕES DE ROTAS -->
            <LinearLayout
                android:id="@+id/containerOpcoesRotas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BOTOES FLUTUANTES CONTROLE DE MAPA (QUANDO VISÍVEL) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnZoomIn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="+"
            android:textSize="20sp"
            app:cornerRadius="24dp"
            android:backgroundTint="#FFFFFF"
            android:textColor="#1A237E"
            app:elevation="6dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnZoomOut"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="-"
            android:textSize="20sp"
            app:cornerRadius="24dp"
            android:backgroundTint="#FFFFFF"
            android:textColor="#1A237E"
            app:elevation="6dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabTrocarMapa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_mapmode"
            app:backgroundTint="#FFFFFF"
            app:tint="#1A237E"
            app:fabSize="mini"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabLocalizacao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_mylocation"
            app:backgroundTint="#1A237E"
            app:tint="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabIA"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_dialog_info"
            app:backgroundTint="#00897B"
            app:tint="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabReportar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_edit"
            app:backgroundTint="#E65100"
            app:tint="#FFFFFF" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>